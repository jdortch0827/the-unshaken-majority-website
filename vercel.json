{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "maxDuration": 15,
      "includeFiles": "investigation.html"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/api/admin-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/api/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin-session",
      "destination": "/api/admin?route=session"
    },
    {
      "source": "/api/admin-investigations",
      "destination": "/api/admin?route=investigations"
    },
    {
      "source": "/api/admin-investigation",
      "destination": "/api/admin?route=investigation"
    },
    {
      "source": "/api/admin-evidence",
      "destination": "/api/admin?route=evidence"
    },
    {
      "source": "/api/admin-corrections",
      "destination": "/api/admin?route=corrections"
    },
    {
      "source": "/api/investigations",
      "destination": "/api/investigation-data?route=list"
    },
    {
      "source": "/api/investigation",
      "destination": "/api/investigation-data?route=detail"
    },
    {
      "source": "/api/latest-investigation",
      "destination": "/api/investigation-data?route=latest"
    },
    {
      "source": "/api/sitemap",
      "destination": "/api/investigation-data?route=sitemap"
    },
    {
      "source": "/server/:path*",
      "destination": "/404"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/investigations/:slug",
      "destination": "/api/investigation-page?slug=:slug"
    },
    {
      "source": "/admin",
      "destination": "/admin-login"
    },
    {
      "source": "/admin/login",
      "destination": "/admin-login"
    },
    {
      "source": "/admin/investigations/new",
      "destination": "/admin-investigation-editor?mode=new"
    },
    {
      "source": "/admin/investigations/:id/edit",
      "destination": "/admin-investigation-editor?id=:id"
    },
    {
      "source": "/admin/investigations/:id/preview",
      "destination": "/admin-preview?id=:id"
    },
    {
      "source": "/admin/investigations",
      "destination": "/admin-investigations"
    }
  ]
}
